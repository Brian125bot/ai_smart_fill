# Server-side Gemini credential. Required for real AI requests.
# Never commit a real key or include it in the extension package.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Optional URL reported by GET /api/health.
# The dashboard normally derives its own URLs from the current browser origin.
APP_URL="MY_APP_URL"

# Optional bind address. The server listens on port 3000, which is currently fixed.
HOST="127.0.0.1"
